# ---- Chain / RPC ----
# Sepolia = 11155111 (default). Local Anvil/Hardhat = 31337.
VITE_DATA_MODE=mock
VITE_CHAIN_ID=11155111
VITE_DEPLOYMENT_BLOCK=
VITE_RPC_URL=https://sepolia.example-rpc.invalid/YOUR_KEY
VITE_RPC_FALLBACK_URL=https://11155111.rpc.thirdweb.com
VITE_EXPLORER_BASE_URL=https://sepolia.etherscan.io
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/
VITE_USDC_ADDRESS=
VITE_MUSDC_FAUCET_ADDRESS=

# ---- WalletConnect ----
# Get a project id at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=

# ---- Auth (Supabase) ----
# Use the project API URL, not the Supabase dashboard URL.
# Google OAuth is enabled in Supabase Auth Providers, not through a VITE secret.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Never add VITE_SUPABASE_SERVICE_ROLE_KEY. VITE_ values are client-visible.
# Edge Functions receive SUPABASE_SERVICE_ROLE_KEY from Supabase server-side.

# ---- Seller KYC (Sumsub) ----
# Backend endpoint that mints a Sumsub access token. NEVER put a Sumsub secret here.
VITE_SUMSUB_BACKEND_URL=

# ---- Contract addresses (leave blank until deployed) ----
# No production addresses are hardcoded; the app treats blanks as "not deployed".
VITE_CONTRACT_DGENFT=
VITE_CONTRACT_GEM_REGISTRY=
VITE_CONTRACT_PAYMENT_TOKEN_REGISTRY=
VITE_CONTRACT_RESERVE_MANAGER=
VITE_CONTRACT_TREASURY=
VITE_CONTRACT_PRIMARY_SALE_AUCTION=
VITE_CONTRACT_MARKETPLACE=
VITE_CONTRACT_SWAP_ESCROW=
VITE_CONTRACT_REDEMPTION_MANAGER=
VITE_CONTRACT_COMPLIANCE_REGISTRY=

# ---- Sanitized observability (optional) ----
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
