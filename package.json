{
  "name": "digital-carat-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"supabase/functions/**/*.ts\" \".github/**/*.yml\" \"*.{json,js,ts}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "test:contracts": "cd ${CONTRACTS_DIR:-../gemstone} && forge test --offline",
    "check": "npm run contracts:check && npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "contracts:sync": "node scripts/sync-contracts.mjs",
    "contracts:check": "node scripts/check-contracts.mjs",
    "seed:sepolia-demo": "node scripts/seed-sepolia-demo-inventory.mjs",
    "verify:sepolia-demo": "node scripts/verify-sepolia-demo-inventory.mjs",
    "verify:anvil-lifecycle": "node scripts/verify-anvil-frontend-lifecycle.mjs",
    "build:favicon": "node scripts/build-favicon.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.1.1",
    "@fontsource/manrope": "^5.1.1",
    "@hookform/resolvers": "^3.9.1",
    "@rainbow-me/rainbowkit": "^2.2.1",
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "@sentry/react": "^10.67.0",
    "@sumsub/websdk-react": "^2.6.4",
    "@supabase/supabase-js": "^2.47.10",
    "@tanstack/react-query": "^5.62.7",
    "posthog-js": "^1.407.1",
    "qrcode-generator": "^1.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.28.0",
    "three": "^0.170.0",
    "viem": "^2.21.55",
    "wagmi": "^2.14.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
